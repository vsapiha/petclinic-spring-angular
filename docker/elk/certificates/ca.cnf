[req]
default_bits = 4096
default_md = sha384
prompt = no
distinguished_name = dn
x509_extensions = usr_cert

[ dn ]
C=NL
O=petclinic.lab
OU=DevSecMlOps
emailAddress=admin@petclinic.lab
CN=Autogenerated Local Root CA for petclinic.lab project

[ usr_cert ]
basicConstraints=CA:TRUE
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid,issuer
