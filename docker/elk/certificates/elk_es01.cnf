[req]
default_bits = 4096
prompt = no
default_md = sha256
x509_extensions = req_ext
req_extensions = req_ext
distinguished_name = dn

[ dn ]
C=NL
O=petclinic.lab
OU=DevSecMlOps
CN=es01

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = es01
DNS.2 = es01.petclinic.lab
DNS.3 = localhost
IP.1 = 127.0.0.1
