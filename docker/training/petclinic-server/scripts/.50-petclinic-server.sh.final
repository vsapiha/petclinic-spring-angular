#!/bin/bash

java -javaagent:/home/elastic/opentelemetry-javaagent.jar \
     -Dotel.exporter.otlp.endpoint=http://apm-server:8200 \
     -Dotel.metrics.exporter=otlp \
     -Dotel.logs.exporter=otlp \
     -Dotel.resource.attributes="service.name=petclinic-server,service.version=1.5.16,deployment.environment=production" \
     -jar /home/elastic/spring-petclinic-1.5.16.jar &

